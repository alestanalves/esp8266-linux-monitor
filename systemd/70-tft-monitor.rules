# ESP8266 / ESP32 USB bridges. Antes de 73-seat-late.rules para aplicar uaccess.
# Ignorar no ModemManager evita que sondagens AT disputem a porta do firmware.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", GROUP="tft-monitor", MODE="0660", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", GROUP="tft-monitor", MODE="0660", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", GROUP="tft-monitor", MODE="0660", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", GROUP="tft-monitor", MODE="0660", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
